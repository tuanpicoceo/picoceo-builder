# Copy to .env.local (git-ignored) and fill in your Meta Model API key.

# Meta Model API (Muse models)
META_API_KEY=
# META_MODEL=muse-spark-1.3-contributor   # default (discounted data-sharing tier); or muse-spark-1.3, muse-wonder-1.0
# META_TRIES=3                     # tries on the same model when it is overloaded or times out
# META_TIMEOUT_MS=120000
# META_BASE_URL=https://api.meta.ai/v1

# Firebase web app config (from the Firebase console: Project settings -> Your apps -> SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=